<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D"
    android:paddingHorizontal="40dp">

    <TextView
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="←"
        android:textColor="#6B6560"
        android:textSize="20sp"
        android:fontFamily="@font/lora"
        android:paddingTop="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/btnPastEntries"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="past"
        android:textColor="#6B6560"
        android:textSize="13sp"
        android:fontFamily="@font/lora"
        android:paddingTop="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/btnSave"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="save"
        android:textColor="#A89880"
        android:textSize="14sp"
        android:fontFamily="@font/lora"
        android:paddingTop="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnPastEntries"/>

    <EditText
        android:id="@+id/editJournal"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@null"
        android:hint="You could start by saying, 'I...'"
        android:textColor="#F5F0E8"
        android:textSize="16sp"
        android:fontFamily="@font/lora"
        android:lineSpacingExtra="8dp"
        android:gravity="top"
        android:inputType="textMultiLine|textCapSentences"
        android:paddingTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
<?xml version="1.0" encoding="utf-8"?>
<!--
    Home screen, v5.

    Three additions to the previous layout:

      • txtDayCount  — quiet "day X of 70" indicator under the start button.
                       Color #6B6560, the dimmest text colour in the app.
                       No bar, no fire emoji, no animation. Just a fact:
                       the user is in an arc with a shape; here is where
                       they are in it. Hidden first session (progressive
                       disclosure tier 2) and after graduation (the arc
                       is over).

      • btnSit       — a low-contrast "sit" door that replaces the missing
                       start button after graduation. Opens RoomActivity:
                       presence-only screen, no counter, no progression.
                       The proposal says "the door stays open. you walk
                       through when you want to." Before this existed the
                       door was actually closed.

      • btnArchive   — "what was said" — the post-graduation archive of
                       the writing the user has already sat with. Faded
                       with age the way the journal fades. Only visible
                       after graduation.

    All three are hidden by default in the XML (visibility="gone" /
    alpha="0") and revealed by HomeActivity based on session count and
    graduation state.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D">

    <!-- Half-density ambient flow. The dust is already with you when you
         open the app, so Breath is the moment it leans toward you, not the
         moment you first meet it. -->
    <com.example.qualia.ui.WeatherFlowView
        android:id="@+id/weatherFlow"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Greeting sits at the upper third — not dead-centre. "Begin session"
         lives just below it as a paired thought, sharing a region of the
         screen. "Journal" is pulled far away — anchored near the bottom —
         so home stops reading as a stacked menu and starts reading as a
         small room with two doors at different walls. -->
    <TextView
        android:id="@+id/txtGreeting"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="You're here."
        android:textColor="#F5F0E8"
        android:textSize="22sp"
        android:fontFamily="@font/lora"
        android:alpha="0"
        android:layout_marginHorizontal="40dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.36"/>

    <TextView
        android:id="@+id/btnStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="begin session"
        android:textColor="#A89880"
        android:textSize="14sp"
        android:letterSpacing="0.2"
        android:fontFamily="@font/lora"
        android:alpha="0"
        android:paddingTop="40dp"
        android:paddingHorizontal="16dp"
        android:paddingBottom="12dp"
        android:layout_marginStart="24dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:layout_constraintTop_toBottomOf="@id/txtGreeting"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Day X of 70. Quiet position-in-arc indicator. Sits just under the
         start button (or where it used to be), indented to align with the
         button's text. Uses the dimmest text colour in the app — this is
         a fact, not an exhortation. There is no bar, no animation, no
         number that grows. Knowing where you are in a 70-day course is
         different from streak-shaming. The view starts at alpha 0 with
         visibility GONE; HomeActivity sets it visible and animates it in
         only when count >= 1 and the user hasn't graduated. -->
    <TextView
        android:id="@+id/txtDayCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="day 1 of 70"
        android:textColor="#6B6560"
        android:textSize="11sp"
        android:letterSpacing="0.15"
        android:fontFamily="@font/lora"
        android:alpha="0"
        android:visibility="gone"
        android:paddingHorizontal="16dp"
        android:paddingTop="2dp"
        android:paddingBottom="12dp"
        android:layout_marginStart="24dp"
        app:layout_constraintTop_toBottomOf="@id/btnStart"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Post-graduation "sit" door. Lives in the same spot the start button
         used to occupy, anchored to the greeting the same way. Lower
         contrast than "begin session" because it offers something quieter
         — not a session, just a room. Hidden until graduation, when
         HomeActivity sets it visible and fades it in. -->
    <TextView
        android:id="@+id/btnSit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="sit"
        android:textColor="#6B6560"
        android:textSize="14sp"
        android:letterSpacing="0.2"
        android:fontFamily="@font/lora"
        android:alpha="0"
        android:visibility="gone"
        android:paddingTop="40dp"
        android:paddingHorizontal="16dp"
        android:paddingBottom="12dp"
        android:layout_marginStart="24dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:layout_constraintTop_toBottomOf="@id/txtGreeting"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Journal is its own door, in its own region. Sits well above the
         bottom toggles (~140dp from the bottom), so the gap below "begin
         session" reads as ma (negative space with weight) instead of a
         missing menu item. -->
    <TextView
        android:id="@+id/btnJournal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="journal"
        android:textColor="#6B6560"
        android:textSize="12sp"
        android:letterSpacing="0.2"
        android:fontFamily="@font/lora"
        android:alpha="0"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="140dp"
        android:layout_marginStart="24dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Post-graduation archive door. Sits above the journal in the same
         bottom-left column. "What was said" — the writing the user has
         already sat with, returned to them in chronological order, faded
         with age. Hidden until graduation. -->
    <TextView
        android:id="@+id/btnArchive"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="what was said"
        android:textColor="#6B6560"
        android:textSize="12sp"
        android:letterSpacing="0.2"
        android:fontFamily="@font/lora"
        android:alpha="0"
        android:visibility="gone"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_marginStart="24dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:layout_constraintBottom_toTopOf="@id/btnJournal"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Session counter — subtle, bottom-right. Doubles as the tap surface
         for the small about / context sheet (literature inspirations,
         crisis-resource line). The tap target is generously padded so it's
         findable without being announced. -->
    <TextView
        android:id="@+id/txtCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#4F4A45"
        android:textSize="11sp"
        android:fontFamily="@font/lora"
        android:letterSpacing="0.15"
        android:alpha="0"
        android:padding="16dp"
        android:paddingBottom="40dp"
        android:layout_marginEnd="24dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="About this app"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Sound toggle — bottom-left, the only chip in this row now that the
         voice toggle has been retired (voice is mandatory). Promoted from
         #2A2A2A (effectively invisible on #0D0D0D) to #4F4A45 so the control
         is visible-but-quiet, matching the dim level used for the secondary
         exit on the closing screen. paddingBottom uses the voice toggle's
         original 32dp so the chip sits in the same place the eye learned
         to find it on devices that ran older builds. -->
    <TextView
        android:id="@+id/btnMute"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="sound on"
        android:textColor="#4F4A45"
        android:textSize="11sp"
        android:fontFamily="@font/lora"
        android:letterSpacing="0.15"
        android:alpha="0"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:paddingBottom="32dp"
        android:layout_marginStart="24dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>

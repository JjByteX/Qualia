<?xml version="1.0" encoding="utf-8"?>
<!--
    Brush-size preset indicator. A solid graphite-coloured circle. Three of
    these in the palette at 6dp / 12dp / 20dp give a visual sense of brush
    thickness that matches the actual stroke width applied.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
       android:shape="oval">
    <solid android:color="#3D332B"/>
</shape>

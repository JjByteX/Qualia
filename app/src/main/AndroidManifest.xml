<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required for the weather API call (Open-Meteo) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Used by SoundManager to fetch weather-matched ambient sound.
         Both coarse and fine are declared; the app only requests coarse
         at runtime (fine is offered as an upgrade by the OS on newer devices). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Polaroid photos: declares the camera as an optional feature so devices
         without one can still install. The runtime camera launch is via
         ACTION_IMAGE_CAPTURE, which uses the system camera app — no direct
         CAMERA permission required for our process. -->
    <uses-feature android:name="android.hardware.camera"
                  android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/qualia"
        android:label="Qualia"
        android:roundIcon="@mipmap/qualia_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Qualia">

        <activity android:name=".ui.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <activity android:name=".ui.OnboardingActivity"/>
        <activity android:name=".ui.HomeActivity"/>
        <activity android:name=".ui.BreathActivity"/>
        <activity android:name=".ui.SessionActivity"/>
        <activity android:name=".ui.ClosingActivity"/>
        <activity android:name=".ui.JournalActivity"/>
        <activity android:name=".ui.PastEntriesActivity"/>
        <activity android:name=".ui.EntryDetailActivity"/>
        <activity android:name=".ui.GraduationActivity"/>
        <activity android:name=".ui.AboutActivity"/>

        <!-- Post-graduation activities (v5). RoomActivity is the "sit"
             room — a presence-only screen reachable after graduation
             from the home screen. PastSessionsActivity is the "what was
             said" archive — chronological list of the session text the
             user has already sat with, faded by age. Neither writes to
             session count, daily gate, or any other progression state;
             they are read-only doors into the room the course built. -->
        <activity android:name=".ui.RoomActivity"/>
        <activity android:name=".ui.PastSessionsActivity"/>

        <!-- FileProvider for handing the system camera a writable URI when
             we capture a polaroid. The authority is qualified with the
             package name so it is unique across installed apps. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"/>
        </provider>

        <meta-data
            android:name="preloaded_fonts"
            android:resource="@array/preloaded_fonts" />

    </application>

</manifest>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D"
    android:paddingHorizontal="40dp">

    <TextView
        android:id="@+id/txtBreath1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Breathe in slowly."
        android:textColor="#F5F0E8"
        android:textSize="18sp"
        android:fontFamily="@font/lora"
        android:alpha="0"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/txtBreath2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/txtBreath2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Then a little more."
        android:textColor="#F5F0E8"
        android:textSize="18sp"
        android:fontFamily="@font/lora"
        android:alpha="0"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/txtBreath3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Now let it go."
        android:textColor="#F5F0E8"
        android:textSize="18sp"
        android:fontFamily="@font/lora"
        android:alpha="0"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/txtBreath2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/btnReady"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="I'm ready"
        android:textColor="#A89880"
        android:textSize="14sp"
        android:letterSpacing="0.2"
        android:fontFamily="@font/lora"
        android:alpha="0"
        android:paddingBottom="60dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
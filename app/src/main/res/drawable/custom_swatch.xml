<?xml version="1.0" encoding="utf-8"?>
<!--
    custom_swatch.xml
    Shown on the "+" colour swatch before the user has picked a custom colour.
    A left-to-right rainbow gradient signals "tap to open the colour picker".
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Rainbow gradient fill -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="#FFFF0000"
                android:centerColor="#FF00FF00"
                android:endColor="#FF0000FF" />
        </shape>
    </item>

    <!-- Thin border matching the other swatches -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="#FFA89880" />
        </shape>
    </item>

</layer-list>

<?xml version="1.0" encoding="utf-8"?>
<!--
    Past entries screen.

    Two views of the same data, swapped via the top-right toggle:
      • List   — chronological entries with previews and the faint medium
                 indicator (existing behaviour).
      • Calendar — month grid with a quiet glow on days that have entries.
                  Empty squares are part of the rhythm; we don't shame the
                  gaps. Tap a day with entries to open the most recent one
                  from that day.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D"
    android:paddingHorizontal="40dp">

    <TextView
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="←"
        android:textColor="#6B6560"
        android:textSize="20sp"
        android:fontFamily="@font/lora"
        android:paddingTop="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="what you wrote"
        android:textColor="#F5F0E8"
        android:textSize="16sp"
        android:fontFamily="@font/lora"
        android:paddingTop="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- View toggle. Tapping swaps between the chronological list and the
         month-grid calendar. Quiet text-only design — matches the rest of
         the screen's restrained palette. -->
    <TextView
        android:id="@+id/btnViewToggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="calendar"
        android:textColor="#9E938A"
        android:textSize="12sp"
        android:fontFamily="@font/lora"
        android:letterSpacing="0.08"
        android:paddingTop="28dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/txtEmpty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Nothing written yet."
        android:textColor="#3A3A3A"
        android:textSize="15sp"
        android:fontFamily="@font/lora"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerEntries"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingTop="16dp"
        android:paddingBottom="40dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/txtTitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <com.example.qualia.ui.CalendarMonthView
        android:id="@+id/calendarView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingTop="16dp"
        android:paddingBottom="24dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/txtTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>

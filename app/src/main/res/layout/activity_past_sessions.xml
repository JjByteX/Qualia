<?xml version="1.0" encoding="utf-8"?>
<!--
    "What was said." A post-graduation archive of the writing the user has
    already sat with. No audio, no order other than chronological, no
    counter. Entries fade with age the way journal entries do when the
    fading toggle is on — anicca, applied to the words the app gave the
    user (not just to the words the user gave the app).

    Reachable only after graduation. The proposal's claim that "the same
    theme reads differently depending on which lens wrote it" only pays
    off if the user can re-read across the arc and notice that. Before
    session seventy, sessions stay ephemeral — that's the discipline.
    After, the discipline has been completed, and what remains is a
    quiet record.

    Structure: a vertical column of session cards, populated
    programmatically by PastSessionsActivity. Each card holds a date, a
    theme, the session text, and the closing line. The whole card's alpha
    is set by age.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D">

    <!-- Lowest density flow underneath, like the about sheet — same room,
         lights turned down. -->
    <com.example.qualia.ui.WeatherFlowView
        android:id="@+id/weatherFlow"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Page header. Very quiet — a label, not a title. -->
    <TextView
        android:id="@+id/txtHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="what was said"
        android:textColor="#6B6560"
        android:textSize="13sp"
        android:letterSpacing="0.2"
        android:fontFamily="@font/lora"
        android:alpha="0"
        android:paddingHorizontal="40dp"
        android:paddingTop="60dp"
        android:paddingBottom="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Shown when the user has no playable history yet. Should be unreachable
         in practice (the button is only on the home screen after seventy
         sessions), but kept here so the screen never appears broken. -->
    <TextView
        android:id="@+id/txtEmpty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Nothing was said here yet."
        android:textColor="#8A8480"
        android:textSize="16sp"
        android:fontFamily="@font/lora"
        android:gravity="center"
        android:visibility="gone"
        android:layout_marginHorizontal="40dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fadeScrollbars="true"
        android:scrollbarStyle="insideOverlay"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/txtHeader"
        app:layout_constraintBottom_toTopOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/cardContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="40dp"
            android:paddingTop="8dp"
            android:paddingBottom="80dp"/>

    </ScrollView>

    <!-- Quiet exit. Same anchor as the about sheet's "back to home". -->
    <TextView
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="back to home"
        android:textColor="#4F4A45"
        android:textSize="11sp"
        android:letterSpacing="0.2"
        android:fontFamily="@font/lora"
        android:alpha="0"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="40dp"
        android:layout_marginEnd="24dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>

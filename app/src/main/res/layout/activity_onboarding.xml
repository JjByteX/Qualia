<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D">

    <!-- Low-density flow underneath. The first time the user meets Qualia,
         the world is still mostly empty — but the language is already here,
         waiting. -->
    <com.example.qualia.ui.WeatherFlowView
        android:id="@+id/weatherFlow"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Four lines arrive one at a time, each its own breath. Onboarding's
         job isn't to explain what the app does — it's to teach the user the
         pacing of the app before they reach the first real screen. The slow
         tempo here is the lesson.

         The fourth line was added in v5: it names the shape of the thing
         the user is about to enter. "Seventy sessions. One a day. Then the
         app ends." The proposal is explicit that the arc is meant to be
         completed and left behind — and that "the end is the point". Saying
         so on the first screen tells the user up front that this is not a
         subscription, not a habit, not a feed. It is a course with a shape.

         Lines 1–3 fade in, dwell, fade out. Line 4 stays — it pairs with
         the "begin" button, the way line 3 used to. All four views are
         centred at the same vertical position and rotate via alpha. -->
    <TextView
        android:id="@+id/txtLine1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="This is a quiet space."
        android:textColor="#F5F0E8"
        android:textSize="20sp"
        android:fontFamily="@font/lora"
        android:gravity="center"
        android:alpha="0"
        android:layout_marginHorizontal="40dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/txtLine2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="There's nothing to figure out."
        android:textColor="#F5F0E8"
        android:textSize="20sp"
        android:fontFamily="@font/lora"
        android:gravity="center"
        android:alpha="0"
        android:layout_marginHorizontal="40dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/txtLine3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="You sit for a moment.\nThe app sits with you."
        android:textColor="#F5F0E8"
        android:textSize="20sp"
        android:fontFamily="@font/lora"
        android:lineSpacingExtra="8dp"
        android:gravity="center"
        android:alpha="0"
        android:layout_marginHorizontal="40dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- New for v5: the shape of the arc, named up front. Same typographic
         weight as the rest of the onboarding lines — this is not a footnote,
         it is the thesis. Pairs with the "begin" button below: read this,
         then choose. -->
    <TextView
        android:id="@+id/txtLine4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Seventy sessions.\nOne a day.\nThen the app ends."
        android:textColor="#F5F0E8"
        android:textSize="20sp"
        android:fontFamily="@font/lora"
        android:lineSpacingExtra="8dp"
        android:gravity="center"
        android:alpha="0"
        android:layout_marginHorizontal="40dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/btnBegin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="begin"
        android:textColor="#A89880"
        android:textSize="14sp"
        android:letterSpacing="0.2"
        android:fontFamily="@font/lora"
        android:alpha="0"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="60dp"
        android:layout_marginStart="24dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>

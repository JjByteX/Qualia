<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D">

    <!-- Flow background — same view as the session screen for visual continuity -->
    <com.example.qualia.ui.WeatherFlowView
        android:id="@+id/weatherFlow"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Three breath lines, all anchored at the upper third of the screen
         (vertical_bias=0.32). The lower two-thirds is left as breathing
         room for the centred bloom — type and bloom no longer fight for
         the same pixels.

         Text rotates via alpha driven by the same animator as the field,
         so the words rise and fall with the visual rather than running
         on a mechanical Handler timeline.

         Copy reverted to the original voice (user picked it on device for
         clarity over the v5 "Slowly, in. / It gathers. / Let it go."):
            "Breathe with the light."  (instruction; field gathers inward)
            "It is still."             (observation; seed at centre)
            "It is letting go."        (observation; warm bloom releases)
         The animator-driven alpha is kept, so the exhale line still rises
         and dissolves on the bloom envelope rather than dwelling past it. -->
    <TextView
        android:id="@+id/txtBreath1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Breathe with the light."
        android:textColor="#F5F0E8"
        android:textSize="22sp"
        android:letterSpacing="0.02"
        android:fontFamily="@font/lora"
        android:gravity="center"
        android:alpha="0"
        android:layout_marginHorizontal="40dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.32"/>

    <TextView
        android:id="@+id/txtBreath2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="It is still."
        android:textColor="#F5F0E8"
        android:textSize="22sp"
        android:letterSpacing="0.02"
        android:fontFamily="@font/lora"
        android:gravity="center"
        android:alpha="0"
        android:layout_marginHorizontal="40dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.32"/>

    <TextView
        android:id="@+id/txtBreath3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="It is letting go."
        android:textColor="#F5F0E8"
        android:textSize="22sp"
        android:letterSpacing="0.02"
        android:fontFamily="@font/lora"
        android:gravity="center"
        android:alpha="0"
        android:layout_marginHorizontal="40dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.32"/>

    <!-- "I'm ready" sits bottom-centre so the eye finishes the breath where
         it started — at centre. The previous bottom-left placement broke
         the radial symmetry of the bloom by pulling the eye sideways. -->
    <TextView
        android:id="@+id/btnReady"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="I'm ready"
        android:textColor="#A89880"
        android:textSize="14sp"
        android:letterSpacing="0.2"
        android:fontFamily="@font/lora"
        android:alpha="0"
        android:paddingHorizontal="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="60dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
